@group
    @title=Index
    @brief=
    @key=index
    @ingroup=

    @example
        @title=test gray
        @gray=no
        1233[br]
        567
    @end

    @example
        @title=example 1
        ```
        using System;

        namespace MyNamespace
        {
            class MyClass
            {
            }
        }
        ```
    @end
    @example
        @title=example 2
        @highlight=cpp
        ```
        #include <stdio.h>

        int main(int argc, char **argv[]) {}
        ```
    @end
    @example
        @title=example 3
        @tabs=yes
        @tab
            @title=cs
            @highlight=cs
       !using System;
       !namespace MyNamespace
       !{
       !    class MyClass
       !    {
       !    }
       !}
        @end
        @tab
            @title=cpp
            @highlight=cpp
       !#include <stdio.h>
       !
       !int main()
       !{
       !    printf("Hello world!\n");
       !}
        @end
    @end

    @example
        @title=HTML
        @highlight=html
        <html><body>Hello, world!</body></html>
    @end
    @example
        @title=HTML
        @highlight=cshtml
