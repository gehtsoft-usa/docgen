@article
    @title=list test
    @key=listtest
    @ingroup=index
    @brief=

    ####   Tricky formatting

    This is **Bold** and __italic__ text.
    We can also do ^^superscript^^ or
    <http://www.google.com> simple links.

    We can also kind of **__mix__ tags**

    [b]Simple list[/b]

    * Item 1
    * Item 2

    * Item 3
    * Item 4

    [b]Multiple list[/b]

    * Item 1
      And item 1
      And Item1

    * Item 2

    - Item Other Kind

    * Item 3
    * Item 4

    Numbered list!

    0 My number list
    * And item
    * And...
      multiline item
    - and Last item

    Here we should stop

    * and `this` should go to a new list


@end

@article
    @title=language test
    @key=langtest
    @ingroup=index
    @brief=

    ```cshml
    <!-- comment -- >
    !<@
        if (a == b)
            return c;
    !@>
    ```

    ```lua
    function a()
        return 'abc';
    end
    ```

    ```luax
    !@Fact()
    class test
        var a : int;
        public function x() : void
            return a;
        end
    end
    ```
@end


@article
    @title=table test
    @key=tabletest
    @ingroup=index
    @brief=

    ####  Simple Table
    |C1,1|C1,2|C1,3|
    |C2,1|C2,2|C2,3|
    |C3,1|C3,2|C3,3|
    ####  Header
    |!,C1,1|C1,2|C1,3|
    |C2,1|C2,2|C2,3|
    |C3,1|C3,2|C3,3|
    ####  width
    |50%,C1,1|C1,2|C1,3|
    |C2,1|C2,2|C2,3|
    |C3,1|C3,2|C3,3|
    ####  header
    |!,C1,1|C1,2|C1,3|
    |C2,1|C2,2|C2,3|
    |C3,1|C3,2|C3,3|
    ####  header and width
    |!50%,C1,1|10%,C1,2|C1,3|
    |C2,1|C2,2|C2,3|
    |C3,1|C3,2|C3,3|
    ####  header and width and 100%
    |!50%,C1,1|10%,C1,2|C1,3|>
    |C2,1|C2,2|C2,3|
    |C3,1|C3,2|C3,3|
@end

@class
    @key=testclass
    @type=class
    @brief=test class
    @name=testclass

    @member
        @visibility=public
        @scope=class
        @type=method
        @name=m1
        @brief=method

        @declaration
            @language=luax
            @return=string
            @prefix=static
            @params=a : int, b : real
        @end

    @end

    @member
        @visibility=public
        @scope=class
        @type=property
        @name=m2
        @brief=property

        @declaration
            @language=luax
            @return=datetime
            @prefix=static
        @end

    @end
@end

@article
    @title=diagrams test
    @key=testdiagrams
    @ingroup=index
    @brief=

    @example
        @highlight=diagram
        @show=yes
        !stateDiagram-v2
        !    [*] --> Still
        !    Still --> [*]
        !
        !    Still --> Moving
        !    Moving --> Still
        !    Moving --> Crash
        !    Crash --> [*]
    @end
@end

@article
    @title=decliaration in example
    @key=declarationinexample
    @ingroup=index
    @brief=

    @example
        @title=Declaration
        @show=always
        @tabs=yes

        @tab
            @title=prototype
            @highlight=luax
            function x (a : int) : void
        @end
        @tab
            @title=javascript
            @highlight=javascript
            function y (a)
        @end
        @tab
            @title=c++
            @highlight=cpp
            void y(const int a);
        @end
        @tab
            @title=java
            @highlight=java
            void y(int a);
        @end
    @end
@end
