<?xml version="1.0" ?>
<dg:help-project xmlns:dg="http://www.gehtsoft.com/docgen/project">
    <!-- dances with tambouring to make it working -->
    <dg:source>
        <dg:file name="./src/null.ds" encoding="windows-1252" />
    </dg:source>

    <dg:output template="%docgen%\template\doxygen2ds\main.xsl" file="./null-file" encoding="utf-8" >
        <!-- where doxigen output is located -->
        <dg:define name="xml-path" value=".\doxygen\xml\" />
        <!-- where to put ds files -->
        <dg:define name="ds-path" value=".\dst\" />
        <!-- the list of files -->
        <!-- the output codepage (you may want to use 1252 instead of 65001) -->
        <dg:define name="codepage" value="65001" />
        <!-- the name of the group to include all classes to -->
        <dg:define name="group" value="main" />

        <dg:define name="language" value="java" />
        <dg:define name="divisor" value="." />
        <dg:define name="exclude-namespace" value="java:.*" />
    </dg:output>
</dg:help-project>