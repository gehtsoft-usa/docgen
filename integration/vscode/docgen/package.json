{
    "name": "docgen",
    "displayName": "DocGen Support",
    "publisher": "Gehtsoft",
    "description": "Gehtsoft Documentation Source Code",
    "version": "0.0.9",
    "repository": {
        "type": "git",
        "url": "https://github.com/gehtsoft-usa/docgen"
    },
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Other"
    ],
    "contributes": {
        "languages": [
            {
                "id": "docgen",
                "aliases": [
                    "DocGen",
                    "ds"
                ],
                "extensions": [
                    ".ds"
                ],
                "firstLine": "^\\s*@(group|class|article)",
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "docgen",
                "scopeName": "source.docsource",
                "path": "./syntaxes/docgen.tmLanguage.xml"
            }
        ]
    },
    "activationEvents": [
        "*"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "tsc -p ./",
        "compile": "tsc -p ./",
        "tslint": "tslint ./src/**/*.ts",
        "watch": "tsc -w -p ./",
        "package": "vsce package"
    },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.1.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "eslint": "^8.20.0",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "typescript": "^4.7.4",
    "@vscode/test-electron": "^2.1.5"
   },
   "dependencies": {
        "xmldom": "^0.1.27",
        "iconv-lite": "^0.5.0",
        "n-readlines": "^1.0.0"
    }
}
