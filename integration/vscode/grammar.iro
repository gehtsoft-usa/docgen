      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.entity.name;
   }
   
   : pattern {
      regex \= ^(\s*)(@divisor)(\s*)(=)(\s*)(\S?.*)$
      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.entity.name;
   }
   
   : pattern {
      regex \= ^(\s*)(@index)(\s*)(=)(\s*)(\S?.*)$
      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.entity.name;
   }
   
   : pattern {
      regex \= ^(\s*)(@type)(\s*)(=)(\s*)(property|field|method|constructor|function)(\s*)$
      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.entity.name,.whitespace;
   }
   
   : pattern {
      regex \= ^(\s*)(@type)(\s*)(=)(\s*)(\S?.*)$
      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.illegal;
   }
   
   : pattern {
      regex \= ^(\s*)(@visibility)(\s*)(=)(\s*)(public|protected|private|package)(\s*)$
      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.entity.name,.whitespace;
   }
   
   : pattern {
      regex \= ^(\s*)(@visibility)(\s*)(=)(\s*)(\S?.*)$
      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.illegal;
   }
   
   : pattern {
      regex \= ^(\s*)(@scope)(\s*)(=)(\s*)(class|instance)(\s*)$
      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.entity.name,.whitespace;
   }
   
   : pattern {
      regex \= ^(\s*)(@scope)(\s*)(=)(\s*)(\S?.*)$
      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.illegal;
   }
   
   : pattern {
      regex \= ^(\s*)(@excludeFromList)(\s*)(=)(\s*)(yes|no)(\s*)$
      styles[] = .whitespace,.keyword,.whitespace,.punctuation,.whitespace,.entity.name,.whitespace;
   }
   
   : pattern {
