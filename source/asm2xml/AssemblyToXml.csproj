<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net90;net80;net70;net472;net50;net60</TargetFrameworks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

 <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <PropertyGroup>
    <TargetAppDir>$(MSBuildProjectDirectory)/../../bin</TargetAppDir>
  </PropertyGroup>

  <ItemGroup>
    <CompiledResult Include="$(TargetDir)/*.*" />
  </ItemGroup>

  <Target Name="CopyLastBuild" AfterTargets="AfterBuild" Condition="$(TargetFramework) == 'net50'">
    <Copy SourceFiles="@(CompiledResult)" DestinationFolder="$(TargetAppDir)" />
</Target>

</Project>
