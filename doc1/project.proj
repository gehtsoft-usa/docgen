<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>netstandard2.0</TargetFramework>
 </PropertyGroup>
 <PropertyGroup>
  <DocTargetDir>$(MSBuildProjectDirectory)/dst</DocTargetDir>
  <HtmlTemplateDir>$(docgen)/template/html</HtmlTemplateDir>
 </PropertyGroup>
 <ItemGroup>
  <CustomFile Include="$(MSBuildProjectDirectory)/img/**/*.png;$(MSBuildProjectDirectory)/html/**/*.*" />
  <TemplateResources1 Include="$(HtmlTemplateDir)/res/**/*.*;" />
  <TemplateResources2 Include="$(HtmlTemplateDir)/highlighter/**/*.*;" />
  <TemplateResources3 Include="$(HtmlTemplateDir)/menu/**/*.*;" />
  <TemplateResources4 Include="$(HtmlTemplateDir)/pageImages/**/*.*;" />
  <CurrentDocTargetDir Include="$(DocTargetDir)" />
  <CurrentRawDir Include="$(RawDir)" />
 </ItemGroup>
 <Target Name="CleanDoc">
  <RemoveDir Directories="@(CurrentDocTargetDir)" />
  <RemoveDir Directories="@(CurrentRawDir)" />
 </Target>
 <Target Name="MakeDoc">
  <RemoveDir Directories="@(CurrentDocTargetDir)" />
  <MakeDir Directories="$(DocTargetDir)" />
  <!-- <DocGen Project="project.xml" /> -->
  <Exec Command="dotnet ../bin/docgen.dll project.xml" />
  <Copy SourceFiles="@(CustomFile)" DestinationFolder="$(DocTargetDir)" />
  <Copy SourceFiles="@(TemplateResources1)" DestinationFolder="$(DocTargetDir)/res" />
  <Copy SourceFiles="@(TemplateResources2)" DestinationFolder="$(DocTargetDir)/highlighter" />
  <Copy SourceFiles="@(TemplateResources3)" DestinationFolder="$(DocTargetDir)/menu" />
  <Copy SourceFiles="@(TemplateResources4)" DestinationFolder="$(DocTargetDir)/pageImages" />
 </Target>
</Project>