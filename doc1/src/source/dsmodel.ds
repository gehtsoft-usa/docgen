@class
    @name=Document Source Format
    @brief=The section describes format of the documentation source tags.
    @key=modelDS
    @ingroup=sources
    @type=tags
    @membersToContent=true

    At the top level of the documentation file only following elements may be used
    [clink=modelDS.article]article[/clink], [clink=modelDS.class]class[/clink], [clink=modelDS.group]group[/clink]

    @member
        @type=property
        @name=article
        @brief=The article
        @custom=xml-tag


        @param
            @name=title
            The title of the object
        @end

        @param
            @name=ingroup
            The key of the group to which the object belongs to. All objects except the index group must belong to some group
        @end

        @param
            @name=brief
            A brief (one-two sentence) summary of the object
        @end

        @param
            @name=key
            The unique key of the article (must be unique among articles, groups and classes)
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        @param
            @name=transform
            A flag indicating whether the content contains BB-codes
        @end

        @param
            @name=aliasId
            The alias of article for HtmlHelp topic list
        @end

        @param
            @name=excludeFromList
            The flag indicating whether the article should not be displayed in the list of the articles in the group and content tree
        @end

        The element may contain the following elements:
        [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.see]see[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=class
        @brief=The class specification
        @custom=xml-tag

        @param
            @name=parent
            The name of the parent class. Note: it is not a key to a parent class in the documentation, just an arbitrary text
        @end

        @param
            @name=import
            The flag indicating that the class must also display members of another classes (e.g. to use it include parent's class members)
        @end

        @param
            @name=name
            The name of the object
        @end

        @param
            @name=sig
            A signature of the class
        @end

        @param
            @name=prefix
            A prefix for the class name
        @end

        @param
            @name=key
            The unique key of the article (must be unique among articles, groups and classes)
        @end

        @param
            @name=brief
            A brief (one-two sentence) summary of the object
        @end

        @param
            @name=type
            A type of the class. The types interpretation depends on the template used.
        @end

        @param
            @name=membersToContent
            The flag indicating whether members of the class needs to be exposed in the content tree
        @end

        @param
            @name=ingroup
            The key of the group to which the object belongs to. All objects except the index group must belong to some group
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        @param
            @name=sort
            The flag indicating whether the members needs to be sorted by the name ("yes" by default)
        @end

        @param
            @name=declname
            The name of the class to be used in declarations (the same as the class name by default)
        @end

        @param
            @name=transform
            A flag indicating whether the content contains BB-codes
        @end

        @param
            @name=writeSignatures
            [c]yes[/c], [c]no[/c], [c]def[/c]

            The flag indicating whether the signatures (aka name plus parameters)
            of the methods will be added to the list of the
            methods and constructors in the class.

            The option is useful for classes with lot of overloads.
        @end

        The element may contain the following elements:
        [clink=modelDS.declaration]declaration[/clink], [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.member]member[/clink], [clink=modelDS.param]param[/clink], [clink=modelDS.see]see[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=declaration
        @brief=A specification of a method for a language specific declaration
        @custom=xml-tag


        @param
            @name=language
            The programming language
        @end

        @param
            @name=name
            The name of the object
        @end

        @param
            @name=prefix
            The prefix to put before the declaration
        @end

        @param
            @name=custom
            A fully custom declaration
        @end

        @param
            @name=suffix
            A suffix to put after the declaration
        @end

        @param
            @name=name-suffix
            A suffix to add to the name of the member in declaration
        @end

        @param
            @name=params
            The parameter list
        @end

        @param
            @name=return
            The return value
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        The element may contain the following elements:


    @end

    @member
        @type=property
        @name=tab
        @brief=A tab in the example item.
        @custom=xml-tag


        @param
            @name=title
            The title of the object
        @end

        @param
            @name=highlight
            The name of the programming language to do the syntax highlighting (if supported by the output template)
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        @note
            @type=warning
            NOTE: The `example` tag must have the attribute `tabs` set to true
            in order to use `tab` tag.
        @end


    @end

    @member
        @type=property
        @name=example
        @brief=An example.
        @custom=xml-tag


        @param
            @name=title
            The title of the object
        @end

        @param
            @name=transform
            A flag indicating whether the content contains BB-codes
        @end

        @param
            @name=show
            A flag indicating if the example must be fully displayed by default (for output templates that supports collapsing of the examples)
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        @param
            @name=gray
            A flag indicating whether the example must be displayed on gray background
        @end

        @param
            @name=tabs
            A flag indicating whether the example tag contains the text in its body or has one or more tab.

            @note
                @type=warning
                NOTE: If tabs are enabled all the content must be in the tabs!
            @end
        @end

        @param
            @name=highlight
            The name of the programming language to do the syntax highlighting (if supported by the output template)
        @end

        The element may contain the following elements:
        [clink=modelDS.tab]tab[/clink], [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=exception
        @brief=A description of the exception thrown by the method
        @custom=xml-tag


        @param
            @name=name
            The name of the object
        @end

        The element may contain the following elements:
        [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=group
        @brief=A group of articles, classes and other groups
        @custom=xml-tag


        @param
            @name=title
            The title of the object
        @end

        @param
            @name=brief
            A brief (one-two sentence) summary of the object
        @end

        @param
            @name=ingroup
            The key of the group to which the object belongs to. All objects except the index group must belong to some group
        @end

        @param
            @name=importhhc
            A name of the custom HTML HELP content file to be added to the group content
        @end

        @param
            @name=importhhk
            A name of the custom HTML HELP keywords file to be added to the group content
        @end

        @param
            @name=sortarticles
            A flag indicating whether articles needs to be sorted by the name
        @end

        @param
            @name=sortgroups
            A flag indicating whether groups needs to be sorted by the name
        @end

        @param
            @name=sortclasses
            A flag indicating whether classes needs to be sorted by the name
        @end

        @param
            @name=key
            The unique key of the article (must be unique among articles, groups and classes)
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        @param
            @name=order
            If the value is set to "custom" the documentation won't do any grouping or sorting of the objects inside the group
        @end

        @param
            @name=transform
            A flag indicating whether the content contains BB-codes
        @end

        The element may contain the following elements:
        [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.see]see[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=headline
        @brief=A header in the description
        @custom=xml-tag


        @param
            @name=level
            The level of the header (1 to 4)
        @end

        The element may contain the following elements:
        [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=list
        @brief=A list
        @custom=xml-tag


        @param
            @name=type
            The type of the list (e.g. num). If type isn't set, the list will be a bulleted list
        @end

        The element may contain the following elements:
        [clink=modelDS.list]list[/clink], [clink=modelDS.list-item]list-item[/clink]

    @end

    @member
        @type=property
        @name=list-item
        @brief=An element of a list
        @custom=xml-tag


        The element may contain the following elements:
        [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=member
        @brief=A member of a class
        @custom=xml-tag


        @param
            @name=name
            The name of the object
        @end

        @param
            @name=sig
            A platform-specific signature of the member (e.g. for .NET type)
        @end

        @param
            @name=visibility
            Visibility of the member (e.g. public, protected)
        @end

        @param
            @name=scope
            The scope of the member (static or instance)
        @end

        @param
            @name=brief
            A brief (one-two sentence) summary of the object
        @end

        @param
            @name=type
            The type of the member (e.g. field, property, method)
        @end

        @param
            @name=key
            The unique key of the article (must be unique among articles, groups and classes)
        @end

        @param
            @name=divisor
            A divisor between the class name and method name to be used (a dot (.) by default)
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        @param
            @name=excludeFromList
            The flag indicating whether the member must be excluded from list of members in the class
        @end

        @param
            @name=transform
            A flag indicating whether the content contains BB-codes
        @end

        The element may contain the following elements:
        [clink=modelDS.declaration]declaration[/clink], [clink=modelDS.example]example[/clink], [clink=modelDS.exception]exception[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.param]param[/clink], [clink=modelDS.return]return[/clink], [clink=modelDS.see]see[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=param
        @brief=A parameter of a member of a class or of a generic class
        @custom=xml-tag


        @param
            @name=name
            The name of the object
        @end

        @param
            @name=gray
            The flag indicating that the parameter must be displayed on highlighted background
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        The element may contain the following elements:
        [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=return
        @brief=A value returned from a class
        @custom=xml-tag


        The element may contain the following elements:
        [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=see
        @brief=A see-also reference to another topic
        @custom=xml-tag


        @param
            @name=key
            The unique key of the article (must be unique among articles, groups and classes)
        @end

        @param
            @name=title
            The title of the object
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        The element may contain the following elements:
        [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=table
        @brief=A table
        @custom=xml-tag


        @param
            @name=width
            The width of the table in percents
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        The element may contain the following elements:
        [clink=modelDS.row]row[/clink]

    @end

    @member
        @type=property
        @name=col
        @brief=A table column
        @custom=xml-tag


        @param
            @name=width
            The width of the column in percents
        @end

        The element may contain the following elements:
        [clink=modelDS.example]example[/clink], [clink=modelDS.headline]headline[/clink], [clink=modelDS.list]list[/clink], [clink=modelDS.table]table[/clink]

    @end

    @member
        @type=property
        @name=row
        @brief=A table row
        @custom=xml-tag


        @param
            @name=header
            The flag indicating whether the row is a header row of the table
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end

        The element may contain the following elements:
        [clink=modelDS.col]col[/clink]

    @end

    @member
        @type=property
        @name=note
        @brief=A note (highlighted piece of text)
        @custom=xml-tag


        @param
            @name=type
            The type of the note

            Check for the template specification for
            details on the list of the supported types.

            For example `html` template supports
            `note`, `warning` and `quote`.
        @end

        @param
            @name=if
            A name of the definition to be set in the doc project file in order to include the object into the documentation. The value is optional. If no value is set, the object will be always included
        @end
    @end

@end
